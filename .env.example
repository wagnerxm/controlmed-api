# ═══════════════════════════════════════════════
# ControlCheck API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ═══════════════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=controlcheck
POSTGRES_USER=controlcheck
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_AQUI

# ── API ──
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_AQUI
CORS_ORIGIN=*

# ── Domínio (para HTTPS) ──
DOMAIN=controlcheck.duckdns.org

# ── Credenciais SIAC/SISDNIT padrão ──
# Se preenchido, o front não precisa pedir CPF/senha a cada consulta.
# Formato CPF: somente números (00000000000)
SIAC_CPF=
SIAC_SENHA=
SIAC_FISCALIZADORA=RN
